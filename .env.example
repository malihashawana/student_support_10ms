# Copy this file to .env and fill in the values from your own Supabase project.
# The values below are public and point to the Lovable-managed project by default,
# but local development still requires your own SUPABASE_SERVICE_ROLE_KEY and SESSION_SECRET.

# Server-side Supabase credentials
SUPABASE_PROJECT_ID="lsvfayujkcwnatilacuh"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_enRkzwa4czigqgbzNfOxJQ_aklMnauz"
SUPABASE_URL="https://lsvfayujkcwnatilacuh.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_OWN_SERVICE_ROLE_KEY_HERE"

# Client-side Supabase credentials (must match the server-side project)
VITE_SUPABASE_PROJECT_ID="lsvfayujkcwnatilacuh"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_enRkzwa4czigqgbzNfOxJQ_aklMnauz"
VITE_SUPABASE_URL="https://lsvfayujkcwnatilacuh.supabase.co"

# Generate a strong random secret for session cookies:
# openssl rand -hex 32
SESSION_SECRET="YOUR_OWN_RANDOM_SECRET_HERE"
